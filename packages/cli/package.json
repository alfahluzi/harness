{
  "name": "@puna/cli",
  "version": "0.1.0",
  "description": "puna plugin CLI — create, dev, build, link. Scaffolds plugins from templates/plugin/.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
