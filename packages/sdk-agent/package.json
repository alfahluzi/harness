{
  "name": "@puna/sdk-agent",
  "version": "0.1.0",
  "description": "Plugin SDK — agent-side bridge: withPluginHooks, callModel/callTool wrappers, lifecycle hooks.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --external @puna/sdk-shared",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@puna/sdk-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.2"
  },
  "keywords": [
    "puna",
    "plugin-sdk",
    "agent"
  ],
  "license": "MIT"
}